# HOW TO USE THIS FILE
# 1. Make a COPY of this file in the same folder.
# 2. Name the copy exactly:  .env   (just dot-e-n-v, nothing before it)
# 3. Fill in your real values below.
#
# Your real .env file is ignored by git (see .gitignore), so your secret
# key never gets uploaded to GitHub. This example file is safe to share
# because it has no real secrets in it.

# Your Google Gemini API key. Get one here: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model Mark LVI should use.
GEMINI_MODEL=gemini-2.5-flash
