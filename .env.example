# Copy to .env and fill in what you have. Anything left blank falls back to
# the built-in mock provider so the dashboard is fully demoable with zero keys.

PORT=4173

# --- Model providers -------------------------------------------------------
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:4173
OPENROUTER_APP_NAME=Agent OS Dashboard
OLLAMA_BASE_URL=http://localhost:11434

# --- Local storage -----------------------------------------------------
# Obsidian vault (PARA method) the dashboard reads/writes memory to.
VAULT_PATH=./vault
# Sandbox directory the Builder is allowed to write files into per run.
WORKSPACE_PATH=./workspace
# Where a passed run's final files get copied after human approval.
PUBLISHED_PATH=./published

# --- Loop engine defaults ---------------------------------------------
LOOP_PASS_THRESHOLD=90
LOOP_MAX_ROUNDS=20

# --- Optional future integrations (not wired up - see README) ---------
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
NETLIFY_AUTH_TOKEN=
WORDPRESS_BASE_URL=
WORDPRESS_APP_PASSWORD=
