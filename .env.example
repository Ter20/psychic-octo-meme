# Claude, acting as CEO/delegator
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# OmniRoute connection details (github.com/diegosouzapw/OmniRoute)
# Get OMNIROUTE_API_KEY from OmniRoute's Dashboard -> Endpoints.
# OMNIROUTE_API_URL defaults to http://localhost:20128, which only works if
# Mission Control runs on the same machine as OmniRoute. If Mission Control
# runs elsewhere (e.g. this cloud sandbox), turn on OmniRoute's remote mode
# (see its REMOTE-MODE.md) and put that public URL + scoped token here instead.
OMNIROUTE_API_URL=
OMNIROUTE_API_KEY=
